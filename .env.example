# Copy this file to .env and fill in the blanks.
#   cp .env.example .env

# Where the local database lives. You do not need Postgres.
ESPORTS_DATABASE_URL=sqlite:///data/esports.db

# Liquipedia requires a User-Agent that names the project and a contact email.
# Use a real email you check. Fake ones can get the project blocked.
LIQUIPEDIA_CONTACT_EMAIL=you@example.com
LIQUIPEDIA_USER_AGENT=esports-model/0.1 (https://github.com/0xAidan/esports-model; you@example.com)
LIQUIPEDIA_MIN_INTERVAL_SEC=2.0

# Suggested bankroll for Kelly sizing advice. This is never spent automatically.
BANKROLL_USD=1000

# Polymarket Gamma + CLOB are free and need no API key.
# The Odds API does not list esports sports keys as of 2026-08-14, so it is unused.
